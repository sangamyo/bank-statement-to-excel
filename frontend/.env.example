# Copy to .env.local (never commit it).
# Full URL of the backend API including /api. Leave unset in local dev to use
# the Vite proxy (/api -> VITE_DEV_PROXY_TARGET).
# VITE_API_URL=https://your-backend.up.railway.app/api

# Dev-only: where the Vite dev server proxies /api (default http://localhost:8000)
# VITE_DEV_PROXY_TARGET=http://localhost:8000
