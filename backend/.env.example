# Copy to .env (never commit .env). All values are optional.
APP_ENV=development
# Comma-separated list of allowed frontend origins (production: your Vercel URL)
ALLOWED_ORIGINS=http://localhost:5173
# Optional regex, e.g. to allow Vercel preview deployments
# ALLOWED_ORIGIN_REGEX=https://bank-statement-to-excel-.*\.vercel\.app
DATA_DIR=./data
MAX_UPLOAD_MB=10
RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=15
PORT=8000
